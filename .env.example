# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored — never commit secrets.

# Mock mode: true = use local mock data; false = real backend
NEXT_PUBLIC_USE_MOCK=true

# Backend API URL (only used when NEXT_PUBLIC_USE_MOCK=false)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google Maps JavaScript API key
# Get one at: https://console.cloud.google.com/google/maps-apis
# Restrict by HTTP referrer to your domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Production (Vercel) — set these in Vercel dashboard, not here ─────────────
# NEXT_PUBLIC_USE_MOCK=false
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_production_key
