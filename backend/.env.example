# ── Database ──────────────────────────────────────────────────────────────────
# Neon: use the POOLED connection string (host contains "-pooler"), which
# handles serverless connection limits. Must include ?sslmode=require
#   postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Render/Fly inject PORT automatically; 3001 is the local default.
PORT=3001

NODE_ENV=production

# ── Frontend origins for CORS (no trailing slash, comma-separated) ────────────
FRONTEND_URL=https://greenranger.kz,https://www.greenranger.kz

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong random secret: `openssl rand -base64 48`
JWT_SECRET=replace_with_a_long_random_string

# ── Email (password reset) ────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=GreenRanger — Astana <onboarding@resend.dev>
