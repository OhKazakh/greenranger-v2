# ── Railway sets DATABASE_URL and PORT automatically ──────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
PORT=3001

# ── Set these manually in Railway dashboard ───────────────────────────────────
NODE_ENV=production

# Your Vercel frontend URL (no trailing slash). Comma-separate if you have
# multiple (e.g. preview + production):
#   FRONTEND_URL=https://greenranger.kz,https://greenranger-v2.vercel.app
FRONTEND_URL=https://greenranger.kz

# Generate a strong random secret: `openssl rand -base64 48`
JWT_SECRET=replace_with_a_long_random_string
